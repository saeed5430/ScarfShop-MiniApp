{
  "name": "telegram-user-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram User Client service for personal sending from admin accounts (login, sessions, message/invoice/voice send, health)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "telegram": "^2.26.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2"
  }
}